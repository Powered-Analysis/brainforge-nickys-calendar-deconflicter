# Copy to .env and fill in. Real environment variables take precedence over .env.
# The same names are the app's Fly secrets. The app reads these names and no others.

# Google Workspace
# The Desktop OAuth client the app calls the Calendar API as.
GCP_CLIENT_ID=
GCP_CLIENT_SECRET=
# The offline refresh token issued to that client for the operator's account.
GCP_REFRESH_TOKEN=
# The operator's primary Workspace domain, e.g. example.com. An attendee outside it makes a
# meeting External/Mixed.
GOOGLE_WORKSPACE_DOMAIN=

# Turso
# From `turso db show --url`.
TURSO_DATABASE_URL=
# From `turso db tokens create`. Leave empty for a local libSQL server that takes no token.
TURSO_AUTH_TOKEN=

# Infrastructure
# The app's public origin, e.g. https://<app>.fly.dev, with no trailing slash. Google's webhook
# address and the Sentience OAuth callback are built from it.
PUBLIC_BASE_URL=
# The bearer token POST /internal/renew-watches requires of the external cron runner.
# Generate one with `openssl rand -hex 32`.
INTERNAL_CRON_SECRET=

# Alerts
# A Resend key with sending access only, for the re-authorization alert.
RESEND_API_KEY=
# The operator's inbox. Without a verified sending domain, Resend delivers only to the address
# its account was registered with.
ALERT_TO=

# Sentience
# The remote MCP server conflicts are dispatched to.
SENTIENCE_MCP_URL=https://mcp.sentience.com/mcp
# The OAuth issuer the app registers with and gets its tokens from.
SENTIENCE_AUTH_ISSUER=https://api.sentience.com
# The id of the existing Sentience chat every conflict is delivered to. Required: without it
# the app dispatches nothing.
SENTIENCE_THREAD_ID=
